# API profilleri (A1, A2) için anahtarlar. Bu dosyayı .env olarak kopyalayıp doldurun; .env git'e girmez.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=sk-ant-
ELEVENLABS_API_KEY=
# Isteğe bağlı: Persona > Ses stüdyosu'ndan 'Genel ses' ya da her tona ses atanırsa gerekmez; ekrandan atanan ses bunun önüne geçer.
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Anthropic anahtarı bir çalışma alanına bağlı değilse gerekli (400: "not scoped to a workspace")
ANTHROPIC_WORKSPACE_ID=
